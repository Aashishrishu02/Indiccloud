
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPPORT
}

enum ProductType {
  VPS_HOSTING
  LINUX_IP_VPS
}

enum OrderStatus {
  PENDING
  PAID
  PROVISIONING
  ACTIVE
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model User {
  id              String    @id @default(uuid())
  name            String?
  email           String    @unique
  passwordHash    String
  role            UserRole  @default(CUSTOMER)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  emailOtps       EmailVerificationOtp[]
  passwordOtps    PasswordResetOtp[]
  vpsInstances    VPSInstance[]
  orders          Order[]
}

model EmailVerificationOtp {
  id        String    @id @default(uuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetOtp {
  id        String    @id @default(uuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VPSInstance {
  id              String    @id @default(uuid())
  userId          String
  orderId         String?   @unique
  provider        String    @default("SMARTVPS")
  providerVpsId   String?   @unique
  ipAddress       String    @unique
  hostname        String?
  operatingSystem String?
  ram             Int?
  status          String    @default("PENDING")
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VPSPlan {
  id           String      @id @default(uuid())
  name         String
  productType  ProductType
  description  String?
  cpuCores     Int
  ramGb        Int
  storageGb    Int
  bandwidthGb  Int?
  price        Decimal     @db.Decimal(10, 2)
  currency     String      @default("INR")
  durationDays Int
  supportedOS  String[]
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orders Order[]

  @@index([productType])
  @@index([isActive])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String
  planId          String
  planName        String
  operatingSystem String
  amount          Decimal     @db.Decimal(10, 2)
  currency        String      @default("INR")
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan        VPSPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment     Payment?
  vpsInstance VPSInstance?

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  provider          String        @default("RAZORPAY")
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status])
}
